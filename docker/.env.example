# ============================================================
# Kenya MAM Dashboard — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# REQUIRED: Absolute path to your pipeline output directory on the HOST machine
# Windows: use forward slashes, e.g.:
#   DATA_DIR=C:/Users/yonas/Documents/ILRI/onset-kenya
# Linux/Mac:
#   DATA_DIR=/home/yonas/onset-kenya
DATA_DIR=C:/Users/yonas/Documents/ILRI/onset-kenya

# OPTIONAL: Forecast operational year (default: 2026)
OP_YEAR=2026

# OPTIONAL: Set to 0 to skip loading BC daily data (faster startup, disables A(D) plume)
# LOAD_BC_DAILY=1

# NOTE: No API keys or tokens needed.
# The dashboard uses MapLibre GL JS with free CARTO basemap tiles.
